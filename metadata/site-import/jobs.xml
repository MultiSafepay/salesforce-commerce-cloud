<?xml version="1.0" encoding="UTF-8"?>
<jobs xmlns="http://www.demandware.com/xml/impex/jobs/2015-07-01">
    <!-- Imports the payment-methods archive that Sync & Import writes to IMPEX/src/instance.
         Sync & Import starts it through OCAPI (POST /jobs/MSP-ImportPaymentMethods/executions);
         it has no schedule of its own. -->
    <job job-id="MSP-ImportPaymentMethods">
        <description>Imports msp-payment-methods.zip, generated by Sync &amp; Import on the Multisafepay settings page.</description>
        <parameters/>
        <flow>
            <context site-id="Sites"/>
            <step step-id="import-msp-payment-methods" type="ImportSiteArchive" enforce-restart="false">
                <description/>
                <parameters>
                    <parameter name="ImportFile">msp-payment-methods.zip</parameter>
                    <parameter name="ImportMode">merge</parameter>
                    <parameter name="ImportFromRealm">false</parameter>
                </parameters>
            </step>
        </flow>
        <rules/>
        <triggers>
            <run-once enabled="false">
                <date>2026-01-01Z</date>
                <time>00:00:00.000Z</time>
            </run-once>
        </triggers>
    </job>
</jobs>
