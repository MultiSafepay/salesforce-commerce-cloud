<iscontent type="text/html" charset="UTF-8" compact="true">
<isinclude url="${URLUtils.url('SiteNavigationBar-IncludeFrameTop','SelectedMenuItem',pdict.SelectedMenuItem,'CurrentMenuItemId',pdict.CurrentMenuItemId)}">
<html lang="en">
   <head>
      <link type="text/css" rel="stylesheet" href="${URLUtils.httpsStatic('/css/multisafepay.css')}"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" integrity="sha384-zCbKRCUGaJDkqS1kPbPd7TveP5iyJE0EjAuZQTgFLD2ylzuqKfdKlfG/eSrtxUkn" crossorigin="anonymous"/>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
      <meta name="viewport" content="width=device-width, initial-scale=1">
   </head>
   <body data-spy="scroll" data-target="#navigationList" data-bs-offset="50" id="formBody" class="bg-light">
        <isset name="logoUrl" value="${dw.system.Site.current.preferences.custom.Multisafepay_Environment == 'TEST' ? 'icons/logo.svg' : 'icons/logo.png'}" scope="page" />
        <div id="saveChangesAlert" class="alert alert-success alert-dismissible fade collapse text-center sticky-top w-5 h-10" role="alert">
            <img src="${URLUtils.staticURL(logoUrl)}" class ="img-fluid" id="logo" alt="multisafepay logo" width="170" height="30" />
            Your Changes have been saved
        </div>
        <div id="notSavedChangesAlert" class="alert alert-success alert-dismissible fade collapse text-center sticky-top w-25" role="alert">
            <img src="${URLUtils.staticURL(logoUrl)}" class ="img-fluid" id="logo" alt="multisafepay logo" width="170" height="30" />
            Your settings could not be saved :( Try again.
        </div>
        <div class="logo row w-100">
            <img src="${URLUtils.staticURL(logoUrl)}" class ="img-fluid" id="logo" alt="multisafepay logo" width="170" height="30" />
            <span class="logo-text">Account Settings</span>
        </div>
        <div id="pageContents" class="mb-5 bg-light">
            <div class="col-6">
                <form id="settingsForm">
                    <isinclude template="multisafepaySettings/requiredSettings"/>
                </form>
            </div>
            <div class="col-8 mt-4">
                <div class="card bg-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Payment Methods</h5>
                            <div>
                                <button type="button" id="syncPaymentMethodsBtn" class="btn btn-outline-primary btn-sm">
                                    &#x21bb; Sync &amp; Import
                                </button>
                            </div>
                        </div>
                        <p class="text-muted small">Enable or disable individual payment methods. Use the Sync &amp; Import button to fetch the latest methods from your MSP account and import them into Salesforce (including country availability).</p>
                        <div id="importMessage" class="alert alert-info small" style="display:none;"></div>
                        <details class="small text-muted mb-3">
                            <summary>OCAPI setup (one-time, for Import button)</summary>
                            <ol class="mt-2">
                                <li>In Account Manager, create an API Client (or use existing) with OCAPI Data permissions</li>
                                <li>In BM (Administration &rarr; Site Development &rarr; Open Commerce API Settings &rarr; Data API &rarr; Global), add:
                                    <pre class="mt-1" style="font-size:11px;">{"_v":"24.5","clients":[{"client_id":"YOUR_CLIENT_ID","resources":[{"resource_id":"/sites/*/payment_methods/*","methods":["put"],"read_attributes":"(**)", "write_attributes":"(**)" }]}]}</pre>
                                </li>
                                <li>In BM (Merchant Tools &rarr; Site Preferences &rarr; Custom Preferences &rarr; Multisafepay), set <em>OCAPI Client ID</em> and <em>OCAPI Client Secret</em></li>
                            </ol>
                            <p>Once configured, clicking <strong>Import in Salesforce</strong> will create Payment Methods in SFCC via OCAPI.</p>
                        </details>
                        <div id="paymentMethodsList">
                            <isif condition="${pdict.paymentMethods && pdict.paymentMethods.length > 0}">
                                <isloop items="${pdict.paymentMethods}" var="method">
                                    <div class="row border py-2 mx-0 my-1 align-items-center payment-method-row" data-gateway="${method.gatewayId}">
                                        <div class="col-md-auto">
                                            <isif condition="${method.iconUrl}">
                                                <img src="${method.iconUrl}" alt="${method.name}" width="40" class="msp-method-icon">
                                            </isif>
                                        </div>
                                        <div class="col">
                                            <strong>${method.name}</strong>
                                            <small class="text-muted ml-2">(${method.gatewayId})</small>
                                            <isif condition="${method.requiresComponent}">
                                                <span class="badge badge-info ml-1">Inline</span>
                                            </isif>
                                            <isif condition="${method.supportsCapture}">
                                                <span class="badge badge-secondary ml-1">Capture</span>
                                            </isif>
                                            <isif condition="${(method.minAmount && method.minAmount > 0) || (method.maxAmount && method.maxAmount > 0)}">
                                                <span class="badge badge-warning ml-1" title="MultiSafepay amount restriction — orders outside this range will not show this method">
                                                    ${method.minAmount > 0 ? 'min ' + method.minAmount : ''}${method.minAmount > 0 && method.maxAmount > 0 ? ' / ' : ''}${method.maxAmount > 0 ? 'max ' + method.maxAmount : ''}
                                                </span>
                                            </isif>
                                            <!--- REQ-1.1.4: an empty country list means MultiSafepay reports
                                                  allowed_countries: [] for this method, i.e. no country restriction.
                                                  Say so explicitly: showing nothing read as missing data. --->
                                            <isif condition="${method.countries}">
                                                <br><small class="text-muted">${method.countries}</small>
                                            <iselse/>
                                                <br><small class="text-muted">All countries</small>
                                            </isif>
                                            <isif condition="${method.currencies}">
                                                <br><small class="text-muted">Currencies: ${method.currencies}</small>
                                            </isif>
                                        </div>
                                        <div class="col-md-auto">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input msp-method-toggle" type="checkbox" data-gateway="${method.gatewayId}" ${method.enabled ? 'checked' : ''}>
                                            </div>
                                        </div>
                                    </div>
                                </isloop>
                            <iselse/>
                                <p class="text-muted">No payment methods synced yet. Click "Sync from MultiSafepay" to load available methods.</p>
                            </isif>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-grid gap-2 d-md-flex justify-content-md-end form-buttons">
            <button type="button" id="settingsFormCancelButton" class="btn btn-outline-dark formButton">Cancel</button>
            <button type="submit" id="settingsFormSubmitButton" class="btn btn-primary border formButton">Save Changes</button>
        </div>
        <script type="text/javascript" src="${URLUtils.httpsStatic('/js/multisafepaySettings.js')}"></script>
   </body>
</html>