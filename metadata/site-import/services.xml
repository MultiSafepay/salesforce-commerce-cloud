<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">

    <service-credential id="Multisafepay.GenerateApiToken.Credentials">
        <url>https://testapi.multisafepay.com/v1/json/auth/api_token</url>
    </service-credential>

    <service-profile id="Multisafepay.GenerateApiToken.Profile">
        <timeout-millis>5000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
    </service-profile>

    <service service-id="Multisafepay.GenerateApiToken">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix>MSP-ApiToken</log-prefix>
        <comm-log-enabled>false</comm-log-enabled>
        <credential-id>Multisafepay.GenerateApiToken.Credentials</credential-id>
        <profile-id>Multisafepay.GenerateApiToken.Profile</profile-id>
    </service>

</services>
