{
  "name": "sfra",
  "version": "6.3.0",
  "description": "Storefront Reference Architecture",
  "main": "index.js",
  "engines": {
    "node": ">=4.0"
  },
  "scripts": {
    "test": "node --test test/msp/*.test.js",
    "test:msp": "node --test test/msp/*.test.js",
    "compile:scss": "set NODE_OPTIONS=--openssl-legacy-provider && sgmf-scripts --compile css",
    "compile:js": "set NODE_OPTIONS=--openssl-legacy-provider && sgmf-scripts --compile js",
    "compilev16:scss": "sgmf-scripts --compile css",
    "compilev16:js": "sgmf-scripts --compile js",
    "compileUnix:scss": "export NODE_OPTIONS=--openssl-legacy-provider && sgmf-scripts --compile css",
    "compileUnix:js": "export NODE_OPTIONS=--openssl-legacy-provider && sgmf-scripts --compile js",
    "compile:fonts": "node bin/Makefile compileFonts",
    "build": "npm run compile:js && npm run compile:fonts && npm run compile:scss",
    "buildv16": "npm run compilev16:js && npm run compile:fonts && npm run compile:v16scss",
    "buildUnix": "npm run compileUnix:js && npm run compile:fonts && npm run compileUnix:scss",
    "lint": "npm run lint:css && npm run lint:js",
    "lint:css": "sgmf-scripts --lint css",
    "lint:js": "sgmf-scripts --lint js",
    "init:isml": "./node_modules/.bin/isml-linter --init",
    "lint:isml": "./node_modules/.bin/isml-linter",
    "build:isml": "./node_modules/.bin/isml-linter --build",
    "fix:isml": "./node_modules/.bin/isml-linter --autofix",
    "upload": "sgmf-scripts --upload",
    "uploadCartridge": "sgmf-scripts --uploadCartridge app_storefront_base && sgmf-scripts --uploadCartridge modules && sgmf-scripts --uploadCartridge bm_app_storefront_base",
    "watch": "sgmf-scripts --watch",
    "watch:static": "sgmf-scripts --watch static",
    "release": "node bin/Makefile release --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SalesforceCommerceCloud/storefront-reference-architecture.git"
  },
  "author": "Ilya Volodin <ivolodin@demandware.com>",
  "license": "ISC",
  "homepage": "https://github.com/SalesforceCommerceCloud/storefront-reference-architecture",
  "devDependencies": {
    "@babel/core": "^7.6.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.6.2",
    "@babel/preset-env": "^7.6.3",
    "babel-loader": "^8.0.6",
    "chalk": "^1.1.3",
    "css-loader": "^1.0.1",
    "eslint": "^3.19.0",
    "eslint-config-airbnb-base": "^5.0.3",
    "eslint-plugin-import": "^1.16.0",
    "eslint-plugin-sitegenesis": "~1.0.0",
    "husky": "^4.2.5",
    "isml-linter": "^5.26.4",
    "lodash": "^4.17.15",
    "postcss-loader": "^3.0.0",
    "sass": "^1.51.0",
    "sass-loader": "^7.3.1",
    "sgmf-scripts": "^2.4.2",
    "shelljs": "^0.8.5",
    "style-loader": "^0.21.0",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^17.0.0",
    "stylelint-scss": "^2.5.0"
  },
  "dependencies": {
    "bootstrap": "^4.6.1",
    "cleave.js": "^1.5.3",
    "flag-icon-css": "^2.9.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.5.1"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ],
  "packageName": "multisafepay",
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint",
      "pre-push": "npm run test"
    }
  }
}
