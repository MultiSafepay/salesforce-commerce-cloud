# Enforce consistent line endings across all platforms.
# Text files are stored and checked out with LF, so ESLint's
# `linebreak-style` rule passes on Windows, macOS and Linux alike.
* text=auto eol=lf

# Binary assets: never apply line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.jar   binary
