<iscontent type="text/html" charset="UTF-8" compact="true">
<link type="text/css" rel="stylesheet" href="${URLUtils.httpsStatic('/css/multisafepay.css')}"/>

<isset name="logoUrl" value="${String(dw.system.Site.current.preferences.custom.Multisafepay_Environment).toLowerCase() === 'test' ? 'icons/logo.svg' : 'icons/logo.png'}" scope="page" />
<isset name="mspPaymentInstrument" value="${pdict.Order.getPaymentInstruments('MultiSafepayPayment').length > 0 ? pdict.Order.getPaymentInstruments('MultiSafepayPayment')[0] : null}" scope="page" />
<!--- Custom string attributes come back as Java String objects, not JS primitives:
      `value === 'completed'` is then ALWAYS false however the text reads. Convert
      once, here, so every comparison downstream is between primitives. --->
<isset name="mspStatus" value="${String((mspPaymentInstrument && mspPaymentInstrument.paymentTransaction ? mspPaymentInstrument.paymentTransaction.custom.Multisafepay_OrderStatus : '') || '')}" scope="page" />
<isset name="mspGateway" value="${String((mspPaymentInstrument ? mspPaymentInstrument.custom.Multisafepay_Gateway : '') || '')}" scope="page" />
<isset name="mspCapturedAtRaw" value="${mspPaymentInstrument && mspPaymentInstrument.paymentTransaction ? mspPaymentInstrument.paymentTransaction.custom.Multisafepay_CapturedAt : null}" scope="page" />
<isset name="mspCapturedAt" value="${mspCapturedAtRaw != null && ('' + mspCapturedAtRaw).length > 10 ? ('' + mspCapturedAtRaw) : null}" scope="page" />
<isset name="mspManualCapture" value="${dw.system.Site.current.preferences.custom.Multisafepay_ManualCapture === true}" scope="page" />
<isscript>
    // Deciding when to offer "Capture".
    //
    // The previous rule was an ALLOW-list on the financial status
    // (initialized | uncleared). Any order whose financial status had not been
    // stored — webhook processed before Multisafepay_FinancialStatus existed in
    // the metadata, a notification that did not carry the field, or an order
    // created before this attribute was introduced — fell through it and the
    // button never appeared, even though MSP was showing Capture on its side.
    //
    // It is now a DENY-list: an authorized payment is capturable unless it is
    // demonstrably already settled, refunded or dead. An unknown financial status
    // no longer hides the button. Capturing a payment that turns out not to need
    // it fails harmlessly on the MSP API and is reported to the merchant.
    var mspFinancialStatus = '';
    var mspCaptureExpiry = '';
    // Whether THIS method supports authorize-then-capture, taken from the API
    // (manual_capture.supported && manual_capture.is_enabled) and stored on the
    // MSPPaymentMethod CO at sync time. `null` means "could not be determined"
    // (CO missing / metadata not imported), which must not be read as "false".
    var mspSupportsCapture = null;

    /**
     * Reads one custom attribute, tolerating an attribute the metadata does not
     * define.
     *
     * These reads used to be gated on a describe()-based attribute-definition
     * lookup. That guard is what hid the Capture button: Multisafepay_OrderStatus, which
     * is read directly a few lines above, renders fine, while both attributes
     * behind the guard came back empty on orders that demonstrably carry them
     * (orders with capture=manual and a capture_expiry). The
     * guard was answering "not defined" for attributes that are defined, so the
     * values never reached the template.
     *
     * Reading the attribute and catching the failure is both simpler and strictly
     * more robust: it cannot be wrong about what exists, because it just tries.
     */
    function mspRead(obj, name) {
        try {
            var value = obj.custom[name];
            return (value === null || value === undefined) ? '' : value;
        } catch (readErr) {
            return '';
        }
    }

    var mspTxn = (mspPaymentInstrument && mspPaymentInstrument.paymentTransaction)
        ? mspPaymentInstrument.paymentTransaction : null;
    if (mspTxn) {
        mspFinancialStatus = String(mspRead(mspTxn, 'Multisafepay_FinancialStatus'));
        mspCaptureExpiry = String(mspRead(mspTxn, 'Multisafepay_CaptureExpiry'));
    }

    try {
        var CustomObjectMgr = require('dw/object/CustomObjectMgr');
        var mspCapCo = mspGateway ? CustomObjectMgr.getCustomObject('MSPPaymentMethod', mspGateway) : null;
        if (mspCapCo) {
            // Only an explicit boolean is an answer. An attribute that is defined
            // but was never written reads as null, which means "not synced yet" —
            // not "does not support capture".
            var mspRawSupports = mspRead(mspCapCo, 'supportsCapture');
            if (mspRawSupports === true || mspRawSupports === false) {
                mspSupportsCapture = mspRawSupports;
            }
        }
    } catch (coErr) {
        mspSupportsCapture = null;
    }

    // Financial states in which the money has already moved (or can no longer be
    // moved) — the only ones that rule capture out.
    var mspSettledStates = ['completed', 'refunded', 'partial_refunded', 'declined', 'expired', 'cancelled', 'void', 'chargeback'];
    var mspAlreadySettled = mspSettledStates.indexOf(String(mspFinancialStatus).toLowerCase()) > -1;

    // The order status must show an authorization exists. Deliberately NOT
    // 'uncleared': that is the BNPL state, and BNPL is settled by notifying the
    // shipment (see the MSP-NotifyShipments job), never by this button.
    //
    // Compare on the normalised copy. This line used to test the raw attribute for
    // strict equality with the literal 'completed', and was false on every order:
    // the attribute is a Java String object, and strict equality
    // against a primitive can never match one, whatever the text says.
    var mspStatusText = String(mspStatus || '').toLowerCase();
    var mspAuthorized = mspStatusText === 'completed';
    var mspAwaitingCapture = mspAuthorized && !mspAlreadySettled;

    // Is this payment a manual-capture one? Decide it from the ORDER, not from
    // configuration.
    //
    // MultiSafepay returns `capture_expiry` only for a payment that was authorized
    // with capture=manual and has not been captured yet, so its presence on the
    // transaction is proof, carried by the order itself. That matters here because
    // this template renders inside Business Manager, where the site preference and
    // the site-scoped MSPPaymentMethod Custom Object are not reliably readable —
    // reading them returns nothing rather than failing, which silently turned into
    // "manual capture is off" and hid the button on orders that were plainly
    // awaiting capture (capture=manual, a non-zero capture_remain,
    // financial status 'initialized', and still no button).
    //
    // Configuration may therefore only ADD confidence, never remove it.
    var mspCaptureProvenByOrder = !!mspCaptureExpiry;
    var mspCaptureLikelyByConfig = mspManualCapture && mspSupportsCapture !== false;
    var mspIsManualCapturePayment = mspCaptureProvenByOrder || mspCaptureLikelyByConfig;

    var mspShowCapture = mspIsManualCapturePayment && !mspCapturedAt && mspAwaitingCapture;
    var mspShowCaptureInfo = mspIsManualCapturePayment && (mspCapturedAt || mspAwaitingCapture);

    // Why the Capture button is or is not there, recorded where it cannot be lost.
    // The MSP log is not a reliable place for this: the `multisafepay` custom log
    // category has to be switched on per instance, and on a sandbox where it is
    // off every Logger call is silently discarded — which is exactly how this bug
    // stayed invisible. An HTML comment costs nothing, is invisible to the
    // merchant, and can be read from View Source on any instance.
    var mspCaptureDiagnostics = 'MSP capture decision:'
        + ' gateway=' + mspGateway
        + ' orderStatus=' + mspStatus
        + ' financialStatus=' + (mspFinancialStatus || '(empty)')
        + ' capturedAt=' + (mspCapturedAt || '(none)')
        + ' captureExpiry=' + (mspCaptureExpiry || '(empty)')
        + ' prefManualCapture=' + mspManualCapture
        + ' coSupportsCapture=' + mspSupportsCapture
        + ' awaitingCapture=' + mspAwaitingCapture
        + ' -> showCapture=' + mspShowCapture;
    try {
        dw.system.Logger.getLogger('multisafepay', 'MSP').info('[OrderDetail] {0} {1}',
            pdict.Order.currentOrderNo, mspCaptureDiagnostics);
    } catch (logErr) {
        // never let diagnostics break the order detail
    }

    // Gift-card breakdown. Collect every GIFT_CERTIFICATE instrument on
    // the order (supports multiple) and the amount covered by the MSP method, so
    // the merchant sees the full split.
    var mspGiftCards = [];
    var mspGiftCardTotal = 0;
    try {
        var giftInstruments = pdict.Order.getPaymentInstruments('GIFT_CERTIFICATE');
        for (var gi = 0; gi < giftInstruments.length; gi++) {
            var gpi = giftInstruments[gi];
            var gAmt = (gpi.paymentTransaction && gpi.paymentTransaction.amount) ? gpi.paymentTransaction.amount : null;
            mspGiftCards.push({
                code: gpi.maskedGiftCertificateCode,
                formatted: gAmt ? gAmt.toFormattedString() : ''
            });
            if (gAmt) { mspGiftCardTotal += gAmt.value; }
        }
    } catch (giftErr) {
        mspGiftCards = [];
    }

    // Coupon/gift-card breakdown applied on the MSP hosted page, parsed
    // from the payment_methods stored by the webhook (Multisafepay_PaymentBreakdown).
    var mspPaymentBreakdown = [];
    try {
        var breakdownRaw = (mspPaymentInstrument && mspPaymentInstrument.paymentTransaction && mspPaymentInstrument.paymentTransaction.custom.Multisafepay_PaymentBreakdown)
            ? mspPaymentInstrument.paymentTransaction.custom.Multisafepay_PaymentBreakdown : '';
        if (breakdownRaw) {
            var parsed = JSON.parse(breakdownRaw);
            for (var bi = 0; bi < parsed.length; bi++) {
                var entry = parsed[bi];
                mspPaymentBreakdown.push({
                    label: entry.coupon_brand || entry.type || 'Payment',
                    type: entry.type || '',
                    amount: entry.amount != null ? (Math.round((Number(entry.amount) / 100) * 100) / 100) : null
                });
            }
        }
    } catch (bdErr) {
        mspPaymentBreakdown = [];
    }
</isscript>
<isset name="mspAmountRefunded" value="${mspPaymentInstrument && mspPaymentInstrument.paymentTransaction && mspPaymentInstrument.paymentTransaction.custom.Multisafepay_AmountRefunded ? mspPaymentInstrument.paymentTransaction.custom.Multisafepay_AmountRefunded : 0}" scope="page" />
<isset name="mspTransactionID" value="${mspPaymentInstrument && mspPaymentInstrument.paymentTransaction ? mspPaymentInstrument.paymentTransaction.transactionID : ''}" scope="page" />
<BR>
<!-- ${mspCaptureDiagnostics} -->
<table>
	<thead>
		<tr>
			<th align='left' width='150'> <img border='0' src='${URLUtils.staticURL(logoUrl)}' width='111'> </th>
			<th> 
			<input type="hidden" name="Order_Number" id="order_number" value="${pdict.Order.currentOrderNo}">
			<input type="hidden" name="Currency_Code" id="currency_code" value="${pdict.Order.getCurrencyCode()}">
			<input type="hidden" name="Invoice_No" id="invoice_no" value="${pdict.Order.getInvoiceNo()}">
			<input class="form-check-input" type="text" name="Refund_Amount" id="amount" placeholder="Amount to refund" value="">
			<button href="${URLUtils.url('Multisafepay-RefundOrder','orderNumber', pdict.Order.currentOrderNo)}" class="btn btn-primary btn-block btn-order-refund" id="order-refund"> REFUND PAYMENT </button>
			<isif condition="${mspShowCapture}">
				<button class="btn btn-success btn-block btn-order-capture" id="order-capture"> CAPTURE FULL PAYMENT </button>
				<div class="msp-capture-note"><small>MultiSafepay capture always captures the full authorized amount. The amount field above applies to refunds only.</small></div>
			</isif>
			</th>
		</tr>
	</thead>
	<tbody>
		<tr><td class='infobox_title'>Payment info</td></tr>
		<tr>
			<td><strong>Multisafepay_Gateway:</strong></td>
			<td>${mspGateway}</td>
		</tr>
		<tr>
			<td><strong>Transaction ID:</strong></td>
			<td>${mspTransactionID}</td>
		</tr>
		<tr>
			<td><strong>Order Status from MSP platform:</strong></td>
			<td><span style="font-weight:bold; color:${mspStatusText === 'completed' || mspStatusText === 'shipped' ? 'green' : mspStatusText === 'refunded' || mspStatusText === 'partial_refunded' ? 'orange' : mspStatusText === 'declined' || mspStatusText === 'expired' || mspStatusText === 'cancelled' || mspStatusText === 'void' ? 'red' : 'gray'}">${mspStatus}</span></td>
		</tr>
		<isif condition="${mspShowCaptureInfo}">
		<tr>
			<td><strong>Capture Status:</strong></td>
			<td><isif condition="${mspCapturedAt && mspCapturedAt.length > 0}"><span style="font-weight:bold; color:green">Captured on ${mspCapturedAt}</span><iselse/><span style="font-weight:bold; color:orange">Awaiting capture</span></isif></td>
		</tr>
		<isif condition="${mspCaptureExpiry && !mspCapturedAt}">
		<tr>
			<td><strong>Capture Expiry:</strong></td>
			<td><span style="font-weight:bold; color:orange">${mspCaptureExpiry}</span> <small>&mdash; after this deadline MultiSafepay releases the authorization and the payment can no longer be captured.</small></td>
		</tr>
		</isif>
		</isif>
		<isif condition="${mspAmountRefunded > 0}">
		<tr>
			<td><strong>Amount Refunded:</strong></td>
			<td>${mspAmountRefunded} ${pdict.Order.getCurrencyCode()}</td>
		</tr>
		</isif>
		<isif condition="${mspGiftCards.length > 0}">
		<tr><td class='infobox_title'>Gift card breakdown</td></tr>
		<isloop items="${mspGiftCards}" var="giftCard">
		<tr>
			<td><strong>Gift card ${giftCard.code}:</strong></td>
			<td>${giftCard.formatted}</td>
		</tr>
		</isloop>
		<tr>
			<td><strong>${mspGateway} (remaining):</strong></td>
			<td>${dw.util.StringUtils.formatMoney(new dw.value.Money(pdict.Order.getTotalGrossPrice().value - mspGiftCardTotal, pdict.Order.getCurrencyCode()))}</td>
		</tr>
		</isif>
		<isif condition="${mspPaymentBreakdown.length > 1}">
		<tr><td class='infobox_title'>MSP payment breakdown</td></tr>
		<isloop items="${mspPaymentBreakdown}" var="bd">
		<tr>
			<td><strong>${bd.label}:</strong></td>
			<td><isif condition="${bd.amount != null}">${dw.util.StringUtils.formatMoney(new dw.value.Money(bd.amount, pdict.Order.getCurrencyCode()))}</isif></td>
		</tr>
		</isloop>
		</isif>
	</tbody>
</table>
<script type="text/javascript" src="${URLUtils.httpsStatic('/js/multisafepayRefund.js')}?v=2"></script>