<iscontent type="text/html" charset="UTF-8" compact="true">
<isinclude url="${URLUtils.url('SiteNavigationBar-IncludeFrameTop','SelectedMenuItem',pdict.SelectedMenuItem,'CurrentMenuItemId',pdict.CurrentMenuItemId)}">
<html lang="en">
   <head>
      <link type="text/css" rel="stylesheet" href="${URLUtils.httpsStatic('/css/multisafepay.css')}"/>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" integrity="sha384-zCbKRCUGaJDkqS1kPbPd7TveP5iyJE0EjAuZQTgFLD2ylzuqKfdKlfG/eSrtxUkn" crossorigin="anonymous"/>
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
      <meta name="viewport" content="width=device-width, initial-scale=1">
   </head>
   <body data-spy="scroll" data-target="#navigationList" data-bs-offset="50" id="formBody" class="bg-light">
      <isset name="logoUrl" value="${dw.system.Site.current.preferences.custom.Multisafepay_Environment == 'TEST' ? 'icons/logo.svg' : 'icons/logo.png'}" scope="page" />
      <div class="logo row w-100">
         <img src="${URLUtils.staticURL(logoUrl)}" class ="img-fluid" id="logo" alt="multisafepay logo" width="170" height="30" />
         <span class="logo-text">Payment and Refund Dashboard</span>
      </div>

      <div class="row py-3">
         <div class="col-3">
            <div class="card bg-white">
               <div class="card-body row justify-content-between">
                  <h5 class="card-title col">Today's orders</h5>
                  <p class="card-text col text-right">${pdict.transactions.todayTransactions}</p>
               </div>
            </div>
         </div>
         <div class="col-3">
            <div class="card bg-white">
               <div class="card-body row justify-content-between">
                  <h5 class="card-title col">Total orders</h5>
                  <p class="card-text col text-right">${pdict.transactions.totalTransactions}</p>
               </div>
            </div>
         </div>
         <div class="col-3">
            <div class="card bg-white">
               <div class="card-body row justify-content-between">
                  <h5 class="card-title col">Today's refunds</h5>
                  <p class="card-text col text-right">${pdict.transactions.todayRefunds}</p>
               </div>
            </div>
         </div>
         <div class="col-3">
            <div class="card bg-white">
               <div class="card-body row justify-content-between">
                  <h5 class="card-title col">Total refunds</h5>
                  <p class="card-text col text-right">${pdict.transactions.totalRefunds}</p>
               </div>
            </div>
         </div>
      </div>

      <div class="row w-100"> 
         <canvas id="myChart" class="col-6 chart h-auto" style="max-width:50%"></canvas>
         <canvas id="myChart2" class="col-6 chart h-auto" style="max-width:50%"></canvas>
      </div>

      <script>
         function Last7Days () {
            var result = [];
            for (var i=0; i<7; i++) {
               var d = new Date();
               d.setDate(d.getDate() - i);
               result.push(d.getDate() + '-' + (d.getMonth()+1) + '-' + d.getFullYear());
            }
            result.reverse();
            return result;
         }
         var xValues = Last7Days();
         var yValues = JSON.parse('${pdict.transactions.transactionsChart}');
         var yValues2 = JSON.parse('${pdict.transactions.refundChart}');
         var barColors = ["#26B7F0", "#1FA0D5", "#1889BA", "#11729F", "#0A5B84", "#034469", "#004A71"];

         new Chart("myChart", {
            type: "bar",
            data: {
               labels: xValues,
               datasets: [{
                  backgroundColor: barColors,
                  data: yValues
               }]
            },
            options: {
               legend: {display: false},
               title: {
                  display: true,
                  text: "Chart showing revenue over the last 7 days"
               }
            }
         });

         new Chart("myChart2", {
            type: "bar",
            data: {
               labels: xValues,
               datasets: [{
                  backgroundColor: barColors,
                  data: yValues2
               }]
            },
            options: {
               legend: {display: false},
               title: {
                  display: true,
                  text: "Chart showing returns over the last 7 days"
               }
            }
         });
         </script>
   </body>
</html>